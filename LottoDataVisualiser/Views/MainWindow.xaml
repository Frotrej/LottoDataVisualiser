<Window x:Class="LottoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LottoApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Grid>
        <!--definicja siatki-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--zakładki u góry-->
        <TabControl Grid.Row="0" TabStripPlacement="Top" Margin="8">
            <!--LOTTO-->
            <TabItem Header="Lotto" >
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="LottoStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[0].GameName , Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[0].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[0].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[0].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[0].RawResponse, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--EURO JACKPOT-->
            <TabItem Header="Euro Jackpot">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="EuroStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[1].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[1].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[1].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[1].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Multi Multi-->
            <TabItem Header="Multi Multi">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="MultiMultiStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[2].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[2].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[2].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[2].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Mini Lotto-->
            <TabItem Header="Mini Lotto">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="MiniLottoStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[3].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[3].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[3].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[3].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Kaskada-->
            <TabItem Header="Kaskada">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="KaskadaStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[4].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[4].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[4].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[4].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Keno-->
            <TabItem Header="Keno">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="KenoStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[5].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[5].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[5].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[5].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Ekstra Pensja-->
            <TabItem Header="Ekstra Pensja">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="EkstraPensjaStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[6].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[6].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[6].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[6].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Ekstra Premia-->
            <TabItem Header="Ekstra Premia">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="EkstraPremiaStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[7].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[7].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[7].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[7].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Szybkie 600-->
            <TabItem Header="Szybkie 600">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="Szybkie600StackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[8].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[8].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[8].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[8].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!--Zakłady Specjalne-->
            <TabItem Header="Zakłady Specjalne">
                <Border Grid.Row="1" Margin="8" Background="#FFF5F5F5" CornerRadius="4">
                    <ScrollViewer>
                        <StackPanel x:Name="ZakładySpecjalneStackPanel" Margin="12" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[9].GameName, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[9].DrawDate, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[9].WinningNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                            <TextBox TextWrapping="Wrap" Text="{Binding GamesDrawsList[9].BonusNumbersText, Mode=OneWay}" Width="auto" Height="auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>


        <!--przyciski w dole-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button x:Name="OkButton" Width="80" Height="30" Content="OK" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Width="80" Height="30" Content="Apply" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Width="80" Height="30" Content="Cancel"/>
        </StackPanel>

    </Grid>
</Window>
