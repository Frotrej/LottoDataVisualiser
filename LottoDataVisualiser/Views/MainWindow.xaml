<Window x:Class="LottoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LottoApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/GameTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!--definicja siatki-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--zakładki u góry-->
        <TabControl Grid.Row="0" TabStripPlacement="Top" Margin="8" ItemsSource="{Binding GamesResults}" ContentTemplate="{StaticResource GameTemplate}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding GameName}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>


        <!--przyciski w dole-->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button x:Name="OkButton" Width="80" Height="30" Content="OK" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Width="80" Height="30" Content="Apply" Margin="0,0,8,0"/>
            <Button x:Name="CancelButton" Width="80" Height="30" Content="Cancel"/>
        </StackPanel>

    </Grid>
</Window>
