<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <DataTemplate x:Key="GameTemplate">
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="{Binding GameName}" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding DrawDate, StringFormat='{}{0:dd MMM yyyy}'}" FontStyle="Italic" FontSize="12"/>
            <TextBlock Text="{Binding WinningNumbersText}" FontSize="12"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>