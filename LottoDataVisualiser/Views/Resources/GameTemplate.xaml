<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <DataTemplate x:Key="GameTemplate">
        <StackPanel x:Name="GameContainer">
            <StackPanel x:Name="GameInfo" Orientation="Vertical" Margin="5">
                <TextBlock Text="{Binding GameName}" FontSize="20" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding DrawDate, StringFormat='{}{0:dd MMM yyyy}'}" FontStyle="Italic" FontSize="14"/>
                <TextBlock Text="{Binding WinningNumbersText}" FontSize="14"/>
            </StackPanel>
            <StackPanel x:Name="Charts" Orientation="Vertical" Margin="5">

            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
